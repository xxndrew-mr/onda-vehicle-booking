# ============ Google BigQuery ============
# Salin file ini menjadi .env.local lalu isi dengan kredensial service account GCP.
# Service account membutuhkan role "BigQuery Data Editor" + "BigQuery Job User".

GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-gcp-project-id.iam.gserviceaccount.com
# Salin private_key dari file JSON service account, biarkan \n apa adanya (dalam satu baris).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ============ Lark SSO ============
# Dari Lark Developer Console (https://open.larksuite.com) → Credentials & Basic Info.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domain Lark Open Platform. Lark internasional (default) vs Feishu (China):
#   https://open.larksuite.com   |   https://open.feishu.cn
LARK_OPEN_BASE_URL=https://open.larksuite.com

# URL publik aplikasi ini (untuk OAuth redirect_uri). Saat dev: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ============ Session ============
# String acak minimal 32 karakter, mis. hasil: openssl rand -base64 48
SESSION_SECRET=

# ============ Role Mapping (dari struktur org Lark) ============
# Email yang menjadi Administrator aplikasi (dipisah koma).
ADMIN_EMAILS=admin@onda.co.id
# Nama departemen di Lark yang anggotanya mendapat role GA (dipisah koma).
GA_DEPARTMENT_NAMES=General Affairs,GA
