# ============================================================
# TEMPLATE — JANGAN taruh nilai asli di file ini (ikut ter-commit ke Git).
# Lokal: salin ke `.env.local` (di-ignore Git) dan isi di sana.
# Produksi (Vercel): isi di Project → Settings → Environment Variables.
# ============================================================

# ============ Google BigQuery ============
# Service account butuh role "BigQuery Data Editor" + "BigQuery Job User".
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-gcp-project-id.iam.gserviceaccount.com

# Private key service account. DUA cara:
# (A) Paling aman untuk Vercel/Docker — base64 dari private_key (tanpa newline/kutip):
#     PowerShell:  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content sa.json | ConvertFrom-Json).private_key))
GOOGLE_PRIVATE_KEY_BASE64=
# (B) Atau PEM langsung. Di .env.local boleh pakai kutip + \n literal (dotenv merapikan).
#     Di env Vercel JANGAN pakai kutip. Kode menormalisasi kutip/\n otomatis.
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============ Lark SSO ============
# Dari Lark Developer Console (https://open.larksuite.com) → Credentials & Basic Info.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxxx
LARK_APP_SECRET=your-lark-app-secret

# Domain: Lark internasional (default) atau Feishu (China):
#   https://open.larksuite.com   |   https://open.feishu.cn
LARK_OPEN_BASE_URL=https://open.larksuite.com

# URL publik aplikasi (untuk OAuth redirect_uri). Produksi: https://booking-mobil.onda.works
APP_BASE_URL=http://localhost:3000

# ============ Session ============
# String acak minimal 32 karakter, mis. hasil: openssl rand -base64 48
SESSION_SECRET=

# ============ Role Mapping (dari struktur org Lark) ============
# Administrator via open_id Lark (paling andal — tidak butuh scope email).
# Isi open_id Anda (mis. ou_xxx). Lihat log server saat login: "[Lark login] ... open_id=ou_...".
ADMIN_LARK_IDS=
# Atau administrator via email (butuh scope contact:user.email:readonly).
ADMIN_EMAILS=admin@onda.co.id
# Nama departemen di Lark yang anggotanya mendapat role GA (dipisah koma).
GA_DEPARTMENT_NAMES=General Affairs,GA

# PA (Personal Assistant) MELEWATI tahap supervisor — booking langsung ke GA.
# Cara utama: nama departemen Lark (PERSIS, case-insensitive, dipisah koma).
PA_DEPARTMENT_NAMES=Personal Assistant Commissioner,Sekretaris & PA
# Tambahan (opsional): daftar open_id PA. Lihat log "[Lark login]" untuk open_id.
PA_LARK_IDS=
# Tambahan (opsional): cocokkan job title Lark secara PERSIS.
PA_JOB_TITLES=PA,Personal Assistant
